@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@namespace Client.Components
@inherits FluentInputBase<TValue>
@typeparam TValue

<FluentTextField
    Value="@CurrentValueAsString"
    ValueChanged="@OnTextChangedAsync"
    Label="@Label"
    AriaLabel="@AriaLabel"
    Name="@Name"
    Required="@Required"
    Placeholder="@Placeholder"
    Disabled="@Disabled"
    ReadOnly="@ReadOnly"
    Autofocus="@Autofocus"
    Embedded="@Embedded"
    Immediate="@Immediate"
    ImmediateDelay="@ImmediateDelay"
    DisplayName="@DisplayName"
    Class="@Class"
    Style="@Style"
    Id="@Id"
    Appearance="@Appearance"
    InputMode="@ResolvedInputMode"
    Pattern="[0-9.]*"
    AdditionalAttributes="@AdditionalAttributes" />

@code {
    [Parameter]
    public FluentInputAppearance Appearance { get; set; } = FluentInputAppearance.Outline;

    [Parameter]
    public string ParsingErrorMessage { get; set; } = "The {0} field must be a (valid) number.";

    protected override string? FormatValueAsString(TValue? value)
    {
        return value switch
        {
            null => null,
            sbyte int8 => BindConverter.FormatValue((short)int8, CultureInfo.InvariantCulture),
            byte uint8 => uint8.ToString(CultureInfo.InvariantCulture),
            short int16 => BindConverter.FormatValue(int16, CultureInfo.InvariantCulture),
            ushort uint16 => uint16.ToString(CultureInfo.InvariantCulture),
            int int32 => BindConverter.FormatValue(int32, CultureInfo.InvariantCulture),
            uint uint32 => uint32.ToString(CultureInfo.InvariantCulture),
            long int64 => BindConverter.FormatValue(int64, CultureInfo.InvariantCulture),
            ulong uint64 => BindConverter.FormatValue(uint64, CultureInfo.InvariantCulture)?.ToString(),
            float single => BindConverter.FormatValue(single, CultureInfo.InvariantCulture),
            double @double => BindConverter.FormatValue(@double, CultureInfo.InvariantCulture),
            decimal @decimal => BindConverter.FormatValue(@decimal, CultureInfo.InvariantCulture),
            _ => throw new InvalidOperationException($"Unsupported type {value.GetType()}."),
        };
    }

    protected override bool TryParseValueFromString(
        string? value,
        [MaybeNullWhen(false)] out TValue result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        try
        {
            if (BindConverter.TryConvertTo(value, CultureInfo.InvariantCulture, out result))
            {
                validationErrorMessage = null;
                return true;
            }
        }
        catch (ArgumentException)
        {
            result = default!;
        }

        validationErrorMessage = string.Format(
            CultureInfo.InvariantCulture,
            ParsingErrorMessage,
            DisplayName ?? FieldIdentifier.FieldName);

        return false;
    }

    private InputMode? ResolvedInputMode
    {
        get
        {
            var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

            if (type == typeof(float) || type == typeof(double) || type == typeof(decimal))
            {
                return InputMode.Decimal;
            }

            if (type == typeof(sbyte) ||
                type == typeof(byte) ||
                type == typeof(short) ||
                type == typeof(ushort) ||
                type == typeof(int) ||
                type == typeof(uint) ||
                type == typeof(long) ||
                type == typeof(ulong))
            {
                return InputMode.Numeric;
            }

            return null;
        }
    }

    private Task OnTextChangedAsync(string? value)
        => SetCurrentValueAsStringAsync(SanitizeNumericInput(value));

    private static string? SanitizeNumericInput(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }

        var chars = new char[value.Length];
        var index = 0;
        var dotSeen = false;

        foreach (var current in value)
        {
            if (char.IsDigit(current))
            {
                chars[index++] = current;
                continue;
            }

            if ((current == '.' || current == ',') && !dotSeen)
            {
                chars[index++] = '.';
                dotSeen = true;
            }
        }

        return new string(chars, 0, index);
    }
}
