@using Microsoft.FluentUI.AspNetCore.Components
@attribute [CascadingTypeParameter(nameof(TGridItem))]
@typeparam TGridItem

<FluentCard Class="surface-card" Style="width: 100%;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="width: 100%;">
        <div style="position: relative; width: 100%;">
            <div style="overflow-x: auto; width: 100%;">
                <FluentDataGrid @ref="_grid"
                                ItemsProvider="@Controller.ProvideItemsAsync"
                                Pagination="@Controller.Pagination"
                                Loading="false"
                                ResizableColumns="@ResizableColumns"
                                ResizeColumnOnAllRows="@ResizeColumnOnAllRows"
                                DisplayMode="@DisplayMode"
                                TGridItem="TGridItem">
                    @ChildContent
                </FluentDataGrid>
            </div>

            @if (Controller.IsPending)
            {
                <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--fill-color, rgba(0,0,0,0.02)); min-height: 200px; z-index: 1;">
                    <FluentProgressRing />
                </div>
            }
        </div>

        @if (Controller.HasNoResults)
        {
            if (EmptyContent != null)
            {
                @EmptyContent
            }
            else
            {
                <FluentLabel Typo="Typography.Body" Color="Color.Neutral">
                    No results found.
                </FluentLabel>
            }
        }

        @if (Controller.CanPaginate)
        {
            <FluentPaginator State="@Controller.Pagination" />
        }
    </FluentStack>
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public PagedGridController<TGridItem> Controller { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public bool ResizableColumns { get; set; } = true;

    [Parameter]
    public bool ResizeColumnOnAllRows { get; set; }

    [Parameter]
    public DataGridDisplayMode DisplayMode { get; set; } = DataGridDisplayMode.Table;

    private FluentDataGrid<TGridItem>? _grid;

    public async Task RefreshAsync(bool resetToFirstPage = false)
    {
        if (resetToFirstPage)
        {
            await ResetToFirstPageSafelyAsync();
        }

        if (_grid != null)
        {
            await _grid.RefreshDataAsync();
        }
    }

    private async Task ResetToFirstPageSafelyAsync()
    {
        if (Controller.Pagination.CurrentPageIndex == 0)
        {
            return;
        }

        try
        {
            await Controller.Pagination.SetCurrentPageIndexAsync(0);
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("EnumFailedVersion", StringComparison.Ordinal))
        {
            // FluentUI callback subscribers can be mutated during a render pass; retry in next turn.
            await Task.Yield();
            if (Controller.Pagination.CurrentPageIndex != 0)
            {
                await Controller.Pagination.SetCurrentPageIndexAsync(0);
            }
        }
    }
}
