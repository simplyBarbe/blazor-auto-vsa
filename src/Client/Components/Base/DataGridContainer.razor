@using Microsoft.FluentUI.AspNetCore.Components

<FluentCard Style="width: 100%;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="width: 100%;">
        <div style="position: relative; width: 100%;">
            <div style="overflow-x: auto; width: 100%;">
                @ChildContent
            </div>

            @if (IsLoading)
            {
                <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--fill-color, rgba(0,0,0,0.02)); min-height: 200px; z-index: 1;">
                    <FluentSpinner />
                </div>
            }
        </div>

        @if (Pagination != null)
        {
            <FluentPaginator State="@Pagination" />
        }
    </FluentStack>
</FluentCard>

@code {
    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public PaginationState? Pagination { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
