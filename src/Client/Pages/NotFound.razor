@page "/not-found"
@layout MainLayout

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentCard Class="surface-card surface-card--compact">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Typo="Typography.PageTitle" Class="page-title">Page Not Found</FluentLabel>
            <FluentLabel Typo="Typography.Body" Class="page-subtitle">
                Sorry, the content you are looking for does not exist or may have moved.
            </FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
                <FluentButton Appearance="Appearance.Accent" Href="/">Back Home</FluentButton>
                <FluentButton Appearance="Appearance.Outline" Href="/products">Open Products</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>
</FluentStack>
