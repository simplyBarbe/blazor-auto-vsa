@page "/login"
@rendermode InteractiveAuto
@using Microsoft.JSInterop
@using Shared.Core.Auth
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div style="max-width: 400px; margin: 100px auto; padding: 20px;">
    <FluentCard Style="padding: 30px;">
        <h2 style="text-align: center; margin-bottom: 30px;">Login</h2>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <FluentMessageBar Title="Error" Intent="MessageIntent.Error" Style="margin-bottom: 20px;">
                @_errorMessage
            </FluentMessageBar>
        }

        <EditForm Model="@_loginRequest" OnValidSubmit="@HandleLogin">
            <FluentStack Orientation="Orientation.Vertical" Style="gap: 20px;">
                <FluentTextField @bind-Value="_loginRequest.Email"
                                 Label="Email"
                                 Placeholder="Enter your email"
                                 Required="true"
                                 Style="width: 100%;" />

                <FluentTextField @bind-Value="_loginRequest.Password"
                                 Label="Password"
                                 Placeholder="Enter your password"
                                 TextFieldType="TextFieldType.Password"
                                 Required="true"
                                 Style="width: 100%;" />

                <FluentCheckbox @bind-Value="_loginRequest.RememberMe"
                                Label="Remember me" />

                <FluentButton Type="ButtonType.Submit"
                              Appearance="Appearance.Accent"
                              Style="width: 100%;"
                              Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <FluentProgressRing Style="width: 20px; height: 20px;" />
                        <span style="margin-left: 10px;">Logging in...</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </FluentButton>
            </FluentStack>
        </EditForm>
    </FluentCard>
</div>

@code {
    private LoginRequest _loginRequest = new();
    private string? _errorMessage;
    private bool _isLoading;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            // Use JS interop to call the API via browser fetch.
            // This is required because cookie auth operations MUST go through
            // the browser's HTTP pipeline, not SignalR (Interactive Server mode).
            var result = await JS.InvokeAsync<LoginResult>(
                "authInterop.login",
                _loginRequest.Email,
                _loginRequest.Password,
                _loginRequest.RememberMe);

            if (result.Succeeded)
            {
                // Redirect to return URL or home (forceLoad to pick up the new cookie)
                var redirectUrl = !string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/";
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
