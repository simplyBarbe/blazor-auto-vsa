@page "/audit-trails"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using Client.Components.Base
@inherits BaseComponent
@using Shared.Features.AuditTrails.Responses
@using Shared.Features.AuditTrails.List
@using Shared.Domain.Enums
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>📜 Audit Trails</PageTitle>

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="20">

    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="8">
        <FluentLabel Typo="Typography.PageTitle" Color="Color.Accent" Class="page-title">📜 Audit Trails</FluentLabel>
        <FluentLabel Typo="Typography.Body" Color="Color.Neutral" Class="page-subtitle">System activity and changes.</FluentLabel>
    </FluentStack>

    <FluentCard Class="surface-card" AreaRestricted="false" Style="position: relative; z-index: 100; width: 100%;">
        <FluentStack Class="page-toolbar-filters" Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                     HorizontalGap="16" Style="overflow: visible;">
            <FluentTextField @bind-Value="Query.SearchTerm" Class="page-toolbar-search" Label="Search Table" Placeholder="e.g. products"
                             @oninput="OnSearchTermChanged"/>

            <FluentSelect TOption="string"
                          Class="page-toolbar-select"
                          Label="Audit Type"
                          Items="@_auditTypeOptions"
                          @bind-Value="SelectedAuditTypeString"
                          Width="200px"/>

            <FluentButton Class="page-toolbar-button page-toolbar-primary" Appearance="Appearance.Accent" OnClick="OnApplyFilterAsync" Disabled="@GridController.IsPending" Style="align-self: flex-end;">Apply
                Filter
            </FluentButton>
        </FluentStack>
    </FluentCard>

    <PagedDataGrid TGridItem="AuditTrailResponse" Controller="@GridController">
            <PropertyColumn Property="@(p => p.TableName)" Sortable="true" Title="Table"/>
            <PropertyColumn Property="@(p => p.AuditType)" Sortable="true" Title="Type"/>
            <PropertyColumn Property="@(p => p.DateTime)" Sortable="true" Title="Date" Format="G"/>
            <TemplateColumn Title="Affected Columns">
                @if (context.AffectedColumns != null && context.AffectedColumns.Any())
                {
                    <span>@string.Join(", ", context.AffectedColumns)</span>
                }
                else
                {
                    <span></span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Actions" Align="Align.End">
                <FluentButton Appearance="Appearance.Lightweight"
                              OnClick="@(() => OnViewDetailsAsync(context))">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="@Color.Accent"/>
                </FluentButton>
            </TemplateColumn>
    </PagedDataGrid>
</FluentStack>
