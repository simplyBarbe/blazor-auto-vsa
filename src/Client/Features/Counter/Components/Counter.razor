@page "/counter"

<PageTitle>Counter</PageTitle>

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentLabel Typo="Typography.PageTitle" Class="page-title">Counter</FluentLabel>
        <FluentLabel Typo="Typography.Body" Class="page-subtitle">
            Lightweight interaction sample using the same page shell and card system as the rest of the app.
        </FluentLabel>
    </FluentStack>

    <FluentCard Class="surface-card surface-card--compact">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentLabel Typo="Typography.Header">Current count</FluentLabel>
            <div role="status">
                <FluentBadge Appearance="Appearance.Neutral" Style="font-size: 1rem; padding: 0.4rem 0.75rem;">
                    @currentCount
                </FluentBadge>
            </div>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
                <FluentButton Appearance="Appearance.Accent" @onclick="IncrementCount">Increment</FluentButton>
                <FluentButton Appearance="Appearance.Outline" @onclick="@(() => currentCount = 0)">Reset</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>
</FluentStack>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
