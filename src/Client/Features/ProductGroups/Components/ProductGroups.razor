@page "/groups"
@using Client.Components.Base
@inherits ProductGroupsBase
@using Shared.Features.ProductGroups.Responses
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>Product groups</PageTitle>

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="8">
        <FluentLabel Typo="Typography.PageTitle" Class="page-title">Product groups</FluentLabel>
        <FluentLabel Typo="Typography.Body" Class="page-subtitle">Subcategories within a category.</FluentLabel>
    </FluentStack>

    <FluentStack Class="page-toolbar" Orientation="Orientation.Horizontal"
                 HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                 VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="12">
        <FluentStack Class="page-toolbar-filters" Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
            <FluentTextField @bind-Value="Query.SearchTerm"
                             Class="page-toolbar-search"
                             Label="Search"
                             Placeholder="Group name..."/>
            <FluentButton Class="page-toolbar-button" Appearance="Appearance.Outline" OnClick="OnApplyFilterAsync" Disabled="@GridController.IsPending">
                Apply
            </FluentButton>
        </FluentStack>

        <FluentButton Class="page-toolbar-button page-toolbar-primary" Appearance="Appearance.Accent" OnClick="OnAddAsync">
            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Slot="start" Color="Color.Custom"
                        CustomColor="var(--foreground-on-accent-rest)"/>
            Add Group
        </FluentButton>
    </FluentStack>

    <PagedDataGrid @ref="Grid" TGridItem="ProductGroupResponse" Controller="@GridController">
        <PropertyColumn Property="@(g => g.Id)" Sortable="true" Title="ID"/>
        <PropertyColumn Property="@(g => g.CategoryName)" Sortable="true" Title="Category"/>
        <PropertyColumn Property="@(g => g.Name)" Sortable="true" Title="Name"/>
        <TemplateColumn Title="Actions" Align="Align.End">
            <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => OnEditAsync(context))">
                <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="@Color.Accent"/>
            </FluentButton>
            <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => OnDeleteAsync(context))" Loading="@IsDeletePending(context)" Disabled="@IsDeletePending(context)">
                <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="@Color.Error"/>
            </FluentButton>
        </TemplateColumn>
    </PagedDataGrid>
</FluentStack>
