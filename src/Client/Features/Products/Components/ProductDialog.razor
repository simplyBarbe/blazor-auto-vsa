@using Shared.Features.Products.Update
@using Shared.Features.Products.Create
@using Client.Components
@using Client.Components.Base
@using Client.Extensions
@inherits BaseComponent
@implements IDialogContentComponent<UpdateProductCommand>

<ActionDialog TCommand="UpdateProductCommand"
                 Content="@Content"
                 IsAddMode="@(Content.Id == 0)"
                 AddTitle="Add Product"
                 EditTitle="Edit Product"
                 SaveState="@_save"
                 OnSave="SaveAsync"
                 OnCancel="CancelAsync">
        <FluentTextField @bind-Value="Content.Name" Label="Name" Required="true" Style="width: 100%;"/>
        <FluentValidationMessage For="@(() => Content.Name)"/>

        <CustomNumericField TValue="decimal" @bind-Value="Content.Price" Label="Price" Required="true"
                            Style="width: 100%;"/>
        <FluentValidationMessage For="@(() => Content.Price)"/>
</ActionDialog>

@code {
    [Parameter] public UpdateProductCommand Content { get; set; } = default!;

    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;
    private MutationResult _save = default!;

    protected override void OnInitialized()
    {
        _save = CreateMutation();
    }

    private async Task SaveAsync(EditContext editContext)
    {
        if (Content.Id == 0)
        {
            var createCommand = new CreateProductCommand(Content.Name, Content.Price);
            var success = await _save.ExecuteAsync(async () =>
            {
                await SendAsync(createCommand, editContext, new RequestOptions(SuccessMessage: "Product created!"));
            });
            if (success) await Dialog.CloseAsync(Content);
        }
        else
        {
            var success = await _save.ExecuteAsync(async () =>
            {
                await SendAsync(Content, editContext, new RequestOptions(SuccessMessage: "Product updated!"));
            });
            if (success) await Dialog.CloseAsync(Content);
        }
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }

}
