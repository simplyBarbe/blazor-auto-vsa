@page "/products"
@using Client.Components.Base
@inherits PagedListComponent<ProductResponse, Shared.Features.Products.List.ListProductQuery>
@using Shared.Features.Products.Responses
@using Shared.Features.Products.List
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>🛒 Product Management</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20"
             Style="width: 100%; padding: 2rem; box-sizing: border-box;">

    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="8">
        @* Label is now exclusivly being used for labeling input fields.
           If you want to use a component that shows text using Fluent's opinions on typography and is more compatible with what was used in v4, you can use the new Text component instead.
           Weight now determines whether label text is regular or semibold. *@
        <FluentLabel>🛒 Product Management</FluentLabel>
        <FluentLabel>Dispatcher Demo - Auto Mode with FluentValidation</FluentLabel>
    </FluentStack>

    <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
        <FluentBadge Appearance="BadgeAppearance.Filled"
                     Color="@(IsBrowser ? BadgeColor.Brand : BadgeColor.Subtle)"
                     Style="padding: 12px 20px; font-size: 14px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="8">
                @if (IsBrowser)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.Globe())" Color="Color.Custom"
                                CustomColor="var(--foreground-on-accent-rest)"/>
                    <FluentLabel>
                        WebAssembly (HTTP API)
                    </FluentLabel>
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.Server())" Color="Color.Custom"
                                CustomColor="var(--neutral-foreground-rest)"/>
                    <FluentLabel>
                        Server-Side Rendering (Direct)
                    </FluentLabel>
                }
            </FluentStack>
        </FluentBadge>
    </FluentStack>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" Style="width: 100%;">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OnAddProductAsync" Disabled="@IsLoading">
            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Slot="start" Color="Color.Custom"
                        CustomColor="var(--foreground-on-accent-rest)"/>
            Add Product
        </FluentButton>
    </FluentStack>

    <DataGridContainer IsLoading="@IsLoading" Pagination="@Pagination">
        <FluentDataGrid @ref="_grid" ItemsProvider="@ProductProvider" Pagination="@Pagination"
                        ResizableColumns="true" ResizeColumnOnAllRows="false"
                        DisplayMode="DataGridDisplayMode.Table"
                        TGridItem="ProductResponse">
            <PropertyColumn Property="@(p => p.Id)" Sortable="true" Title="ID"/>
            <PropertyColumn Property="@(p => p.Name)" Sortable="true" Title="Name"/>
            <PropertyColumn Property="@(p => p.Price)" Sortable="true" Title="Price" Format="C2"/>
            <TemplateColumn Title="Actions">
                <FluentButton Appearance="ButtonAppearance.Transparent" OnClick="@(() => OnEditProductAsync(context))">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="@Color.Primary"/>
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Transparent" OnClick="@(() => OnDeleteProductAsync(context))">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="@Color.Error"/>
                </FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    </DataGridContainer>
</FluentStack>
