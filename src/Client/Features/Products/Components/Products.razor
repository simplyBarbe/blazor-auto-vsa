@page "/products"
@using Client.Components.Base
@inherits ProductsBase
@using Shared.Features.Products.Responses
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>🛒 Product Management</PageTitle>

<FluentStack Class="page-stack" Orientation="Orientation.Vertical" VerticalGap="20">

    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="8">
        <FluentLabel Typo="Typography.PageTitle" Color="Color.Accent">🛒 Product Management</FluentLabel>
        <FluentLabel Typo="Typography.Body" Color="Color.Neutral">Dispatcher Demo - Auto Mode with FluentValidation</FluentLabel>
    </FluentStack>

    <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
        <FluentBadge Appearance="@(IsBrowser ? Appearance.Accent : Appearance.Neutral)"
                     Style="padding: 12px 20px; font-size: 14px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="8">
                @if (IsBrowser)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.Globe())" Color="Color.Custom"
                                CustomColor="var(--foreground-on-accent-rest)"/>
                    <FluentLabel Color="Color.Custom" CustomColor="var(--foreground-on-accent-rest)">
                        WebAssembly (HTTP API)
                    </FluentLabel>
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.Server())" Color="Color.Custom"
                                CustomColor="var(--neutral-foreground-rest)"/>
                    <FluentLabel Color="Color.Custom" CustomColor="var(--neutral-foreground-rest)">
                        Server-Side Rendering (Direct)
                    </FluentLabel>
                }
            </FluentStack>
        </FluentBadge>
    </FluentStack>

    <FluentStack Class="page-toolbar" Orientation="Orientation.Horizontal"
                 HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                 VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="12">
        <FluentStack Class="page-toolbar-filters" Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
            <FluentTextField @bind-Value="Query.SearchTerm"
                             Class="page-toolbar-search"
                             Label="Search"
                             Placeholder="Search product name..." />
            <FluentButton Class="page-toolbar-button" Appearance="Appearance.Outline" OnClick="OnApplyFilterAsync" Disabled="@IsLoading">
                Apply
            </FluentButton>
        </FluentStack>

        <FluentButton Class="page-toolbar-button page-toolbar-primary" Appearance="Appearance.Accent" OnClick="OnAddProductAsync" Disabled="@IsLoading">
            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Slot="start" Color="Color.Custom"
                        CustomColor="var(--foreground-on-accent-rest)"/>
            Add Product
        </FluentButton>
    </FluentStack>

    <DataGridContainer IsLoading="@IsLoading" Pagination="@Pagination">
        <FluentDataGrid @ref="_grid" ItemsProvider="@ProductProvider" Pagination="@Pagination"
                        ResizableColumns="true" ResizeColumnOnAllRows="false"
                        DisplayMode="DataGridDisplayMode.Table"
                        TGridItem="ProductResponse">
            <PropertyColumn Property="@(p => p.Id)" Sortable="true" Title="ID"/>
            <PropertyColumn Property="@(p => p.Name)" Sortable="true" Title="Name"/>
            <PropertyColumn Property="@(p => p.Price)" Sortable="true" Title="Price" Format="C2"/>
            <TemplateColumn Title="Actions" Align="Align.End">
                <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => OnEditProductAsync(context))">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="@Color.Accent"/>
                </FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => OnDeleteProductAsync(context))">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="@Color.Error"/>
                </FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    </DataGridContainer>
</FluentStack>
