<FluentNavMenu Id="main-menu" Width="250" Collapsible="true" Title="Navigation menu" Expanded="@Expanded" ExpandedChanged="@ExpandedChanged">
    <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())">
        Home
    </FluentNavLink>
    <FluentNavLink Href="counter" Icon="@(new Icons.Regular.Size20.NumberSymbolSquare())">
        Counter
    </FluentNavLink>
    <FluentNavLink Href="products" Icon="@(new Icons.Regular.Size20.Box())">Products
    </FluentNavLink>
    <FluentNavLink Href="categories" Icon="@(new Icons.Regular.Size20.Folder())">Categories
    </FluentNavLink>
    <FluentNavLink Href="groups" Icon="@(new Icons.Regular.Size20.Layer())">Groups
    </FluentNavLink>
    <FluentNavLink Href="audit-trails" Icon="@(new Icons.Regular.Size20.History())">Audit Trails
    </FluentNavLink>
</FluentNavMenu>

@code {
    [Parameter]
    public bool Expanded { get; set; } = true;

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }
}
