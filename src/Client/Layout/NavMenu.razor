<FluentNavMenu Id="main-menu" Width="250" Collapsible="true" Title="Navigation menu" Expanded="@Expanded" ExpandedChanged="@ExpandedChanged">
    <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent">
        Home
    </FluentNavLink>
    <FluentNavLink Href="counter" Icon="@(new Icons.Regular.Size20.NumberSymbolSquare())" IconColor="Color.Accent">
        Counter
    </FluentNavLink>
    <FluentNavLink Href="products" Icon="@(new Icons.Regular.Size20.Box())" IconColor="Color.Accent">Products
    </FluentNavLink>
    <FluentNavLink Href="categories" Icon="@(new Icons.Regular.Size20.Folder())" IconColor="Color.Accent">Categories
    </FluentNavLink>
    <FluentNavLink Href="groups" Icon="@(new Icons.Regular.Size20.Layer())" IconColor="Color.Accent">Groups
    </FluentNavLink>
    <FluentNavLink Href="audit-trails" Icon="@(new Icons.Regular.Size20.History())" IconColor="Color.Accent">Audit Trails
    </FluentNavLink>
</FluentNavMenu>

@code {
    [Parameter]
    public bool Expanded { get; set; } = true;

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }
}
