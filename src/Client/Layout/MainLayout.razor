@inherits LayoutComponentBase

<FluentDesignTheme Mode="DesignThemeModes.System" />

<FluentLayout Class="app-layout">
    <FluentHeader Class="app-header">
        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                     VerticalAlignment="VerticalAlignment.Center"
                     Class="header-bar">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         Class="header-start">
                <FluentButton Appearance="Appearance.Stealth"
                              Class="menu-toggle"
                              AriaLabel="Toggle navigation menu"
                              OnClick="@ToggleMenu"
                              IconEnd="@(new Icons.Regular.Size20.LineHorizontal3())"></FluentButton>
                <FluentLabel Typo="Typography.Header" Class="app-title">Server</FluentLabel>
            </FluentStack>
            <Client.Features.Auth.Components.LoginDisplay />
        </FluentStack>
    </FluentHeader>
    <FluentStack Orientation="Orientation.Horizontal"
                 Width="100%"
                 Id="app-main"
                 Class="@(menuExpanded ? "menu-expanded" : "menu-collapsed")">
        <NavMenu Expanded="@menuExpanded" ExpandedChanged="@OnMenuExpandedChanged" />
        <FluentBodyContent Class="app-body">
            <div class="content app-content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>

<FluentToastProvider />
<FluentDialogProvider />
<FluentMessageBarProvider />
<FluentTooltipProvider />
<FluentKeyCodeProvider />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool menuExpanded = true;

    private void OnMenuExpandedChanged(bool expanded)
    {
        menuExpanded = expanded;
    }

    private void ToggleMenu()
    {
        menuExpanded = !menuExpanded;
    }
}
