<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    <PersistingAuthenticationStateProvider>
        <Routes @rendermode="InteractiveAuto" />
    </PersistingAuthenticationStateProvider>
    <ReconnectModal />
    @* <script src="@Assets["_framework/blazor.web.js"]"></script> *@
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/js/loading-theme.js" type="text/javascript"></script>

    <loading-theme storage-name="theme" mode="dark"></loading-theme>
    <FluentDesignTheme StorageName="theme" Mode="DesignThemeModes.Dark" OfficeColor="OfficeColor.Office" />
    <script src="js/auth-interop.js"></script>
</body>

</html>

