@page "/products"
@using Shared.Core
@using Shared.Features.Products.Responses
@using Shared.Features.Products.Create
@using Shared.Features.Products.Get
@using Shared.Core.Validation
@using Client.Components
@using Client.Extensions
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Products - Smart Dispatcher Demo</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" Style="max-width: 1000px; margin: 0 auto; padding: 2rem;">
    
    @* Page Header *@
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="8">
        <FluentLabel Typo="Typography.PageTitle" Color="Color.Accent">
            🛒 Product Management
        </FluentLabel>
        <FluentLabel Typo="Typography.Body" Color="Color.Lightweight">
            Smart Dispatcher Demo - Auto Mode with FluentValidation
        </FluentLabel>
    </FluentStack>

    @* Execution Mode Badge *@
    <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
        <FluentBadge Appearance="@(IsBrowser ? Appearance.Accent : Appearance.Neutral)" 
                     Style="padding: 12px 20px; font-size: 14px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                @if (IsBrowser)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.Globe())" Color="Color.Fill" />
                    <FluentLabel Color="Color.Fill">WebAssembly (HTTP API)</FluentLabel>
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.Server())" Color="Color.Fill" />
                    <FluentLabel Color="Color.Fill">Server-Side Rendering (Direct)</FluentLabel>
                }
            </FluentStack>
        </FluentBadge>
    </FluentStack>

    @* Main Panels Container *@
    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="20" VerticalGap="20">
        
        @* Create Product Panel *@
        <FluentCard Style="flex: 1; min-width: 350px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                
                @* Panel Header *@
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                    <FluentIcon Value="@(new Icons.Regular.Size24.AddCircle())" Color="Color.Accent" />
                    <FluentLabel Typo="Typography.H5">Create Product</FluentLabel>
                </FluentStack>
                
                <FluentDivider Style="width: 100%;" />
                
                @* Create Form with FluentValidation *@
                <EditForm EditContext="@editContext" OnValidSubmit="CreateProduct" FormName="createProduct">
                    <FluentValidationValidator />
                    
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                        @* Name Field with Validation *@
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            <FluentTextField @bind-Value="newProduct.Name" 
                                             Name="productName"
                                             Label="Product Name" 
                                             Placeholder="Enter product name..."
                                             Style="width: 100%;" />
                            <FluentValidationMessage For="@(() => newProduct.Name)" />
                        </FluentStack>
                        
                        @* Price Field with Validation *@
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            <FluentNumberField @bind-Value="newProduct.Price" 
                                               Name="productPrice"
                                               Label="Price (€)" 
                                               Placeholder="0.00"
                                               Step="0.01"
                                               Style="width: 100%;" />
                            <FluentValidationMessage For="@(() => newProduct.Price)" />
                        </FluentStack>
                        
                        @* Server-side Validation Errors *@
                        @if (validationErrors != null && validationErrors.Any())
                        {
                            <FluentMessageBar Title="Errori di Validazione" 
                                              Intent="MessageIntent.Error" 
                                              AllowDismiss="true"
                                              OnDismissClick="@(() => validationErrors = null)">
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                    @foreach (var error in validationErrors)
                                    {
                                        <FluentLabel>@error.ErrorMessage</FluentLabel>
                                    }
                                </FluentStack>
                            </FluentMessageBar>
                        }
                        
                        @* Validation Summary *@
                        <FluentValidationSummary />
                        
                        <FluentButton Type="ButtonType.Submit" 
                                      Appearance="Appearance.Accent"
                                      Loading="@isCreating"
                                      Disabled="@(!isFormValid || isCreating)"
                                      Style="width: 100%;">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Slot="start" />
                            Create Product
                        </FluentButton>
                    </FluentStack>
                </EditForm>

                @* Create Result *@
                @if (createResult is not null)
                {
                    <FluentMessageBar Title="Product Created!" 
                                      Intent="MessageIntent.Success" 
                                      AllowDismiss="true"
                                      OnDismissClick="@(() => createResult = null)">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                                <FluentLabel Weight="FontWeight.Bold">Response via:</FluentLabel>
                                <FluentBadge Appearance="@(createResultMode == "client" ? Appearance.Accent : Appearance.Neutral)">
                                    @(createResultMode == "client" ? "HTTP API" : "SSR Direct")
                                </FluentBadge>
                            </FluentStack>
                            <FluentLabel><strong>ID:</strong> @createResult.Id</FluentLabel>
                            <FluentLabel><strong>Name:</strong> @createResult.Name</FluentLabel>
                            <FluentLabel><strong>Price:</strong> €@createResult.Price.ToString("F2")</FluentLabel>
                        </FluentStack>
                    </FluentMessageBar>
                }
            </FluentStack>
        </FluentCard>

        @* Get Product Panel *@
        <FluentCard Style="flex: 1; min-width: 350px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                
                @* Panel Header *@
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Search())" Color="Color.Accent" />
                    <FluentLabel Typo="Typography.H5">Get Product</FluentLabel>
                </FluentStack>
                
                <FluentDivider Style="width: 100%;" />
                
                @* Search Form *@
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                    <FluentNumberField @bind-Value="searchId" 
                                       Label="Product ID" 
                                       Placeholder="Enter ID..."
                                       Min="1"
                                       Style="width: 100%;" />
                    
                    <FluentButton Appearance="Appearance.Accent"
                                  Loading="@isSearching"
                                  OnClick="SearchProduct"
                                  Disabled="@(searchId < 1)"
                                  Style="width: 100%;">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Slot="start" />
                        Search
                    </FluentButton>
                </FluentStack>

                @* Search Result *@
                @if (searchResult is not null)
                {
                    <FluentMessageBar Title="Product Found" 
                                      Intent="MessageIntent.Info" 
                                      AllowDismiss="true"
                                      OnDismissClick="@(() => searchResult = null)">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                                <FluentLabel Weight="FontWeight.Bold">Response via:</FluentLabel>
                                <FluentBadge Appearance="@(searchResultMode == "client" ? Appearance.Accent : Appearance.Neutral)">
                                    @(searchResultMode == "client" ? "HTTP API" : "SSR Direct")
                                </FluentBadge>
                            </FluentStack>
                            <FluentLabel><strong>ID:</strong> @searchResult.Id</FluentLabel>
                            <FluentLabel><strong>Name:</strong> @searchResult.Name</FluentLabel>
                            <FluentLabel><strong>Price:</strong> €@searchResult.Price.ToString("F2")</FluentLabel>
                        </FluentStack>
                    </FluentMessageBar>
                }
                else if (searchError is not null)
                {
                    <FluentMessageBar Title="Error" 
                                      Intent="MessageIntent.Error" 
                                      AllowDismiss="true"
                                      OnDismissClick="@(() => searchError = null)">
                        @searchError
                    </FluentMessageBar>
                }
            </FluentStack>
        </FluentCard>
    </FluentStack>

    @* Request History Panel *@
    @if (requestHistory.Count > 0)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                
                @* Panel Header *@
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                    <FluentIcon Value="@(new Icons.Regular.Size24.History())" Color="Color.Accent" />
                    <FluentLabel Typo="Typography.H5">Request History</FluentLabel>
                    <FluentSpacer />
                    <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearHistory">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Slot="start" />
                        Clear
                    </FluentButton>
                </FluentStack>
                
                <FluentDivider Style="width: 100%;" />
                
                @* History List *@
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="max-height: 300px; overflow-y: auto;">
                    @foreach (var entry in requestHistory.AsEnumerable().Reverse())
                    {
                        <FluentCard>
                            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                                @if (entry.Mode == "client")
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size20.Globe())" Color="Color.Accent" />
                                }
                                else
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size20.Server())" Color="Color.Success" />
                                }
                                
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="flex: 1;">
                                    <FluentLabel Weight="FontWeight.Bold">@entry.Action</FluentLabel>
                                    <FluentLabel Typo="Typography.Body" Color="Color.Lightweight">
                                        @entry.Timestamp.ToString("HH:mm:ss")
                                    </FluentLabel>
                                </FluentStack>
                                
                                <FluentBadge Appearance="@(entry.Mode == "client" ? Appearance.Accent : Appearance.Neutral)">
                                    @(entry.Mode == "client" ? "HTTP" : "Direct")
                                </FluentBadge>
                            </FluentStack>
                        </FluentCard>
                    }
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }
</FluentStack>
