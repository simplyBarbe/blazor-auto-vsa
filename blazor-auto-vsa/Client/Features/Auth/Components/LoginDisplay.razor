@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Client.Infrastructure.Auth
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<AuthorizeView>
    <Authorized>
        <FluentStack Orientation="Orientation.Horizontal" 
                     VerticalAlignment="VerticalAlignment.Center" 
                     Style="gap: 10px;" 
                     Width="auto">
            <FluentLabel>@context.User.Identity?.Name</FluentLabel>
            <FluentButton Appearance="Appearance.Lightweight" OnClick="@HandleLogout">
                Logout
            </FluentButton>
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/login"))">
            Login
        </FluentButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task HandleLogout()
    {
        try
        {
            // Use JS interop to call logout via browser fetch (required for cookie removal)
            await JS.InvokeAsync<bool>("authInterop.logout");

            // Notify the authentication state provider
            if (AuthStateProvider is CookieAuthStateProvider cookieProvider)
            {
                cookieProvider.NotifyAuthenticationStateChanged(null);
            }

            // Redirect to home (forceLoad to clear the auth state)
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
        }
    }
}
