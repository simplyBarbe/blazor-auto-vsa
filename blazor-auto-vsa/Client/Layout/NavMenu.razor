<FluentNavMenu Id="main-menu" Width="250" Collapsible="true" Title="Navigation menu" @bind-Expanded="expanded">
    <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent">
        Home
    </FluentNavLink>
    <FluentNavLink Href="counter" Icon="@(new Icons.Regular.Size20.NumberSymbolSquare())" IconColor="Color.Accent">
        Counter
    </FluentNavLink>
    <FluentNavLink Href="products" Icon="@(new Icons.Regular.Size20.Box())" IconColor="Color.Accent">Products
    </FluentNavLink>
</FluentNavMenu>

@code {
    private bool expanded = true;

}
